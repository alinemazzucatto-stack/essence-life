import { useEffect, useMemo, useRef, useState } from 'react';
import type { Dispatch, SetStateAction } from 'react';
import type { LocalSession } from '../../shared/app.types';
import type { AppPage } from '../../shared/access-control';
import { createId as id, greeting, plural, today } from '../../shared/app-utils';
import { requestReminderPermission, syncAppReminder, syncDatedReminder } from '../../shared/reminders';

type HomeTask={id:string;title:string;date:string;time?:string;category?:string;priority:string;reminderEnabled?:boolean;reminderTime?:string;done:boolean;kind?:'task'|'habit'|'event'};
type HomeHabit={id:string;name:string;time:string;category:string;days:string[];reminderEnabled?:boolean;reminderTime?:string;done:boolean;doneDate?:string};
type QuickCreate='task'|'habit'|null;
type EnergyLevel='low'|'steady'|'high';
type HabitDayStatus='partial'|'skipped'|'minimum';
type HomeProps={session:LocalSession;pendingHabits:HomeHabit[];pendingTasks:HomeTask[];completedHabits:HomeHabit[];completedTasks:HomeTask[];totalToday:number;completedToday:number;dayProgress:number;waterToday:number;quickCreate:QuickCreate;setQuickCreate:Dispatch<SetStateAction<QuickCreate>>;openPage:(page:AppPage)=>void;registerHomeWater:(amount?:number)=>number;unregisterHomeWater:(amount?:number)=>number;completeHomeHabit:(habitId:string)=>void;completeHomeTask:(taskId:string)=>void;setHomeTasks:Dispatch<SetStateAction<HomeTask[]>>;setHomeHabits:Dispatch<SetStateAction<HomeHabit[]>>};

const read=<T,>(key:string,fallback:T):T=>{try{return JSON.parse(localStorage.getItem(key)||'') as T}catch{return fallback}};
const categoryIcon=(category:string,title:string)=>{
const text=`${category} ${title}`.toLowerCase();
if(text.includes('água')||text.includes('agua')||text.includes('hidrata'))return '💧';
if(text.includes('remédio')||text.includes('remedio')||text.includes('medica')||text.includes('venlafaxina'))return '💊';
if(text.includes('treino'))return '🏋️';
if(text.includes('caminhar')||text.includes('caminhada'))return '🚶';
return ({'saúde':'🩺','bem-estar':'🌿','treinos':'🏋️','casa':'🏠','trabalho':'💼','estudos':'📚','nutrição':'🥗','sono':'🌙','finanças':'💰','beleza':'🪞','pessoal':'✨'}[category.toLowerCase()]||'✓');
};
function Home({session,pendingHabits,pendingTasks,completedHabits,completedTasks,dayProgress,waterToday,quickCreate,setQuickCreate,openPage,registerHomeWater,unregisterHomeWater,completeHomeHabit,completeHomeTask,setHomeTasks,setHomeHabits}:HomeProps){
const [notice,setNotice]=useState(()=>localStorage.getItem('essence:last-snoozed-notification')?'Lembrete adiado recentemente. Revise quando estiver pronto.':'');useEffect(()=>{if(!notice)return;const timer=window.setTimeout(()=>setNotice(''),4200);return()=>window.clearTimeout(timer)},[notice]);
const [energy]=useState<EnergyLevel>(()=>{const saved=read<Record<string,EnergyLevel>>('essence:daily-energy',{});if(saved[today()])return saved[today()];const sleeps=read<{date:string;quality?:number}[]>('essence:sleeps',[]);const latest=sleeps.sort((a,b)=>b.date.localeCompare(a.date))[0];return latest?.date===today()&&Number(latest.quality||0)<=2?'low':'steady'});
const [timelineOpen,setTimelineOpen]=useState<boolean>(true);
const [habitStatuses,setHabitStatuses]=useState<Record<string,HabitDayStatus>>(()=>read<Record<string,HabitDayStatus>>(`essence:habit-status:${today()}`,{}));
const quickCreateRef=useRef<HTMLElement|null>(null);
useEffect(()=>{if(!quickCreate)return;const revealTitle=()=>{const title=quickCreateRef.current?.querySelector<HTMLInputElement>('input[name="title"]');quickCreateRef.current?.scrollIntoView({behavior:'smooth',block:'start'});title?.focus({preventScroll:true});title?.scrollIntoView({behavior:'smooth',block:'center'})};const timers=[0,360,850].map(delay=>window.setTimeout(revealTitle,delay));window.visualViewport?.addEventListener('resize',revealTitle);return()=>{timers.forEach(window.clearTimeout);window.visualViewport?.removeEventListener('resize',revealTitle)}},[quickCreate]);
const showNotice=(message:string)=>{setNotice(message);window.setTimeout(()=>setNotice(''),2600)};
const timeline=useMemo(()=>[...pendingTasks.map(item=>({id:item.id,title:item.title,time:item.time||'',category:item.category||'Pessoal',kind:(item.kind==='event'?'event' as const:'task' as const),done:false})),...pendingHabits.map(item=>({id:item.id,title:item.name,time:item.time||'',category:item.category||'Pessoal',kind:'habit' as const,done:false})),...completedTasks.map(item=>({id:item.id,title:item.title,time:item.time||'',category:item.category||'Pessoal',kind:(item.kind==='event'?'event' as const:'task' as const),done:true})),...completedHabits.map(item=>({id:item.id,title:item.name,time:item.time||'',category:item.category||'Pessoal',kind:'habit' as const,done:true}))].sort((a,b)=>(a.time||'99:99').localeCompare(b.time||'99:99')),[pendingTasks,pendingHabits,completedTasks,completedHabits]);
const pendingCount=pendingTasks.length+pendingHabits.length;
const waterGoal=Number(localStorage.getItem('essence:water-goal')||2000);
const nextBill=read<{type?:string;status?:string;due?:string;title?:string;description?:string}[]>('essence:finance',[]).find(item=>item.type==='Saída'&&item.status==='Pendente'&&!!item.due&&item.due<=today());
const nextTask=[...pendingTasks].sort((a,b)=>{
const weight=(priority:string)=>priority.toLowerCase()==='alta'?0:priority.toLowerCase()==='baixa'?2:1;
const energyWeight=(priority:string)=>energy==='low'?-weight(priority):energy==='high'?weight(priority):0;
return energyWeight(a.priority)-energyWeight(b.priority)||(a.time||'99:99').localeCompare(b.time||'99:99');
})[0];
const nextHabit=[...pendingHabits].sort((a,b)=>a.time.localeCompare(b.time))[0];const nextAction=nextTask?{title:nextTask.title,time:nextTask.time,page:'agenda' as AppPage,kind:'tarefa'}:nextHabit?{title:nextHabit.name,time:nextHabit.time,page:'routine' as AppPage,kind:'hábito'}:nextBill?{title:nextBill.title||nextBill.description||'Revisar conta pendente',time:'',page:'finance' as AppPage,kind:'conta'}:null;
const repeatYesterday=()=>{const y=new Date(Date.now()-86400000).toISOString().slice(0,10);setHomeTasks(items=>{const fromYesterday=items.filter(item=>item.date===y);if(!fromYesterday.length){showNotice('Nenhuma tarefa de ontem para repetir');return items}const existingKeys=new Set(items.filter(item=>item.date===today()).map(item=>item.title+item.time));const created=fromYesterday.filter(item=>!existingKeys.has(item.title+item.time)).map(item=>({...item,id:id(),date:today(),done:false}));if(!created.length){showNotice('Essas tarefas já estão no seu dia');return items}const next=[...items,...created];localStorage.setItem('essence:tasks',JSON.stringify(next));showNotice(plural(created.length,'tarefa repetida','tarefas repetidas')+' de ontem');return next})};
const setHabitDayStatus=(habitId:string,status:HabitDayStatus)=>{const next={...habitStatuses,[habitId]:status};setHabitStatuses(next);localStorage.setItem(`essence:habit-status:${today()}`,JSON.stringify(next));showNotice(status==='partial'?'Registrado como feito parcialmente':status==='minimum'?'Versão mínima escolhida':'Tudo bem. Este hábito fica para outro dia.')};
const dateLabel=new Intl.DateTimeFormat('pt-BR',{weekday:'long',day:'numeric',month:'long'}).format(new Date());
return <section className="home home-v2">
<article className="hero home-dashboard-hero"><div className="home-welcome"><small>{dateLabel}</small><h3>{greeting()}, {session.name}!</h3></div><div className="home-progress-ring" style={{'--progress':`${dayProgress}%`} as React.CSSProperties}><span><strong>{dayProgress}%</strong><small>do dia</small></span><div className="home-progress-track"><i style={{width:dayProgress+'%'}}/></div></div><div className="home-next"><small>PRÓXIMO PASSO IMPORTANTE</small><b>{nextAction?.title||timeline[0]?.title||'Planejar com leveza'}</b><span>{nextAction?.time||timeline[0]?.time||'No seu ritmo'}</span><button className="primary" onClick={()=>openPage('agenda')}>Ver meu dia</button></div></article>
{notice&&<div className="agenda-toast home-toast" role="status">✓ {notice}</div>}
<article className="card home-timeline"><button type="button" className="card-head home-timeline-header home-timeline-toggle" aria-expanded={timelineOpen} onClick={()=>setTimelineOpen(value=>!value)}><div><h3>Meu dia</h3><p>Tarefas, hábitos, compromissos e hidratação, por horário.</p></div><span className="home-pending-badge">{pendingCount} {plural(pendingCount,'pendente','pendentes')}</span><i className={'home-timeline-chevron'+(timelineOpen?' is-open':'')}>⌄</i></button><button type="button" className="home-repeat-yesterday" onClick={repeatYesterday}>↻ Repetir tarefas de ontem</button>{timelineOpen&&<div className="home-timeline-list"><div className="home-timeline-item hydration-item"><button type="button" className={'water-habit-check'+(waterToday>0?' is-done':'')} onClick={()=>{const total=registerHomeWater();showNotice(`Água registrada · ${total} ml hoje`)}} aria-label="Registrar 250 ml de água">💧</button><div><span className="home-item-meta"><i>HIDRATAÇÃO</i><small>{(waterToday/1000).toLocaleString('pt-BR',{minimumFractionDigits:waterToday%1000===0?0:2,maximumFractionDigits:2})} / {(waterGoal/1000).toLocaleString('pt-BR',{maximumFractionDigits:1})} L</small></span><b className="home-item-title">Beber água</b><div className="water-progress-track"><span style={{width:Math.min(100,Math.round(waterToday/waterGoal*100))+'%'}}/></div><div className="water-amount-controls"><button type="button" disabled={waterToday===0} onClick={()=>{const total=unregisterHomeWater();showNotice(`Registro removido · ${total} ml hoje`)}} aria-label="Remover 250 ml">−</button><button type="button" onClick={()=>{const total=registerHomeWater();showNotice(`Água registrada · ${total} ml hoje`)}} aria-label="Adicionar 250 ml">+</button></div></div></div>{timeline.map(item=><div className={`${item.kind==='habit'?'home-timeline-item habit-item':'home-timeline-item task-item'}${item.done?' is-done':''}`} key={item.kind+item.id}><input type="checkbox" checked={item.done} onChange={()=>{if(item.kind==='habit')completeHomeHabit(item.id);else completeHomeTask(item.id);showNotice(item.done?'Ação reaberta':'Ação concluída')}} aria-label={`Concluir ${item.title}`}/><div className="home-item-copy"><span className="home-item-meta"><i>{item.kind==='habit'?'HÁBITO':item.kind==='event'?'COMPROMISSO':'TAREFA'}</i><small>{item.kind==='habit'?'🔥 1 dia':'Hoje'}</small><small className="home-time">{item.time?`◷ ${item.time}`:'Sem horário'}</small></span><b className="home-item-title"><span className="home-row-icon">{categoryIcon(item.category,item.title)}</span>{item.title}</b><small>{item.category}</small>{item.kind==='habit'&&!item.done&&<div className="habit-kind-actions"><button type="button" className={habitStatuses[item.id]==='partial'?'active':''} onClick={()=>setHabitDayStatus(item.id,'partial')}>Fiz parcialmente</button><button type="button" className={habitStatuses[item.id]==='minimum'?'active':''} onClick={()=>setHabitDayStatus(item.id,'minimum')}>Versão mínima</button><button type="button" className={habitStatuses[item.id]==='skipped'?'active':''} onClick={()=>setHabitDayStatus(item.id,'skipped')}>Hoje não consegui</button></div>}</div></div>)}</div>}</article>
<article className="card quick-actions"><div className="card-head quick-actions-head"><div><span className="quick-actions-kicker">ATALHOS DO DIA</span><h3>Ações rápidas</h3><p>Registre o que importa sem interromper seu momento.</p></div></div><div className="quick-actions-grid"><button type="button" onClick={()=>setQuickCreate('task')}><span>＋</span><b>Nova tarefa</b></button><button type="button" onClick={()=>setQuickCreate('habit')}><span>✦</span><b>Novo hábito</b></button><button type="button" onClick={()=>{const total=registerHomeWater();showNotice(`Água registrada · ${total} ml hoje`)}}><span>💧</span><b>+ 250 ml de água</b></button><button type="button" onClick={()=>openPage('diary')}><span>✎</span><b>Escrever no diário</b></button></div></article>
{quickCreate&&<article ref={quickCreateRef} className="card quick-create" tabIndex={-1}><div className="card-head"><div><h3>{quickCreate==='task'?'Nova tarefa':'Novo hábito'}</h3><p>{quickCreate==='task'?'Adicione uma ação para hoje.':'Crie um hábito simples para começar hoje.'}</p></div><button type="button" onClick={()=>setQuickCreate(null)}>Fechar</button></div><form className="form" onSubmit={event=>{event.preventDefault();const form=new FormData(event.currentTarget);const title=String(form.get('title')||'').trim();if(!title)return;const reminderEnabled=form.get('reminderEnabled')==='on',reminderTime=String(form.get('reminderTime')||form.get('time')||'09:00');if(quickCreate==='task'){const entry={id:id(),title,date:today(),time:String(form.get('time')||''),category:String(form.get('category')||'Pessoal'),priority:'Normal',reminderEnabled,reminderTime,done:false};setHomeTasks(items=>{const next=[entry,...items];localStorage.setItem('essence:tasks',JSON.stringify(next));return next});if(reminderEnabled)syncDatedReminder(entry.id,'Tarefa: '+title,entry.date,reminderTime)}else{const entry={id:id(),name:title,time:String(form.get('time')||''),category:String(form.get('category')||'Pessoal'),days:['SEG','TER','QUA','QUI','SEX','SÁB','DOM'],reminderEnabled,reminderTime,done:false};setHomeHabits(items=>{const next=[entry,...items];localStorage.setItem('essence:routine-items',JSON.stringify(next));return next});syncAppReminder(entry.id,'Hábito: '+title,reminderTime,reminderEnabled)}if(reminderEnabled)void requestReminderPermission();showNotice(quickCreate==='task'?'Tarefa adicionada ao dia':'Hábito adicionado ao dia');setQuickCreate(null)}}><label className="wide">{quickCreate==='task'?'O que você precisa fazer?':'Qual hábito deseja criar?'}<input name="title" placeholder={quickCreate==='task'?'Ex.: Enviar mensagem':'Ex.: Caminhar 20 minutos'} required autoFocus onFocus={event=>window.setTimeout(()=>event.currentTarget.scrollIntoView({behavior:'smooth',block:'center'}),120)}/></label><label>Horário<input name="time" type="time"/></label><label>Categoria<select name="category"><option>Pessoal</option><option>Saúde</option><option>Bem-estar</option><option>Trabalho</option><option>Casa</option><option>Estudos</option></select></label><label className="house-check"><input name="reminderEnabled" type="checkbox"/> Ativar lembrete</label><label>Horário do lembrete<input name="reminderTime" type="time" defaultValue="09:00"/></label><button className="primary wide">Adicionar ao meu dia</button></form></article>}
</section>}
export default Home;
